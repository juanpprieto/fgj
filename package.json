{
	"name": "fgj",
	"version": "0.1.0",
	"private": true,
	"description": "Forgejo command-line interface for LLM agents",
	"license": "MIT OR Apache-2.0",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juanpprieto/fgj.git"
	},
	"type": "module",
	"bin": {
		"fgj": "dist/cli.js"
	},
	"scripts": {
		"prepare": "git config core.hooksPath .githooks",
		"test": "bun test",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"format": "biome check --write .",
		"docs:check": "bun scripts/docs-check.ts",
		"docs:verbs": "bun scripts/readme-verbs.ts",
		"build": "bun scripts/build.ts",
		"package": "bun scripts/package.ts",
		"package:native": "bun scripts/package-native.ts",
		"install:local": "bun scripts/install-local.ts",
		"install:uat": "bun scripts/install-uat.ts",
		"uat:shell": "bun scripts/uat-shell.ts",
		"forgejo:start": "bun scripts/forgejo-test-server.ts start",
		"forgejo:stop": "bun scripts/forgejo-test-server.ts stop",
		"forgejo:logs": "bun scripts/forgejo-logs.ts",
		"check:local": "bun scripts/check.ts --local",
		"check": "bun scripts/check.ts"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@types/bun": "1.3.14",
		"typescript": "6.0.3"
	}
}
